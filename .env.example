APP_ENV=production
APP_URL=https://puntorosa.ordena.garciacore.com
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ordena
DB_USERNAME=ordena
DB_PASSWORD=cambia_esta_clave
MYSQL_ROOT_PASSWORD=cambia_root
REDIS_HOST=redis

# Geocodificación
# GEOCODING_PROVIDER=google        -> Google Geocoding API (recomendado; server-side, requiere GOOGLE_GEOCODING_API_KEY + billing en Google Cloud).
# GEOCODING_PROVIDER=nominatim    -> OSM público (gratis, 1 req/seg, muy propenso a rate limit en producción).
# GEOCODING_PROVIDER=positionstack -> Requiere POSITIONSTACK_ACCESS_KEY (plan free 25k peticiones/mes).
GEOCODING_PROVIDER=google
# User-agent obligatorio para Nominatim (nombre de tu app/dominio y correo real de soporte).
GEOCODING_USER_AGENT=OrdenaInicial/1.0 (contacto@tudominio.com)
# Filtra resultados por país (código ISO-3166 alpha-2, ej. MX). Vacío = sin filtro.
# Con Google se envía como components=country:mx en búsquedas.
GEOCODING_COUNTRY=MX
GEOCODING_TIMEOUT=15

# Google Geocoding API (https://maps.googleapis.com/maps/api/geocode)
# Key restringida a uso server-side (IP de tu servidor / restricción por API).
# NUNCA se expone en JavaScript, HTML ni respuestas JSON.
GOOGLE_GEOCODING_API_KEY=
# Idioma y región de las respuestas de Google (language=es, region=mx).
GOOGLE_GEOCODING_LANGUAGE=es
GOOGLE_GEOCODING_REGION=mx

# Intervalo mínimo en segundos entre requests, por provider (0 = sin límite).
# Nominatim exige 1 req/seg; Google y Positionstack no requieren este límite.
GEOCODING_MIN_INTERVAL_NOMINATIM=1
GEOCODING_MIN_INTERVAL_POSITIONSTACK=1
GEOCODING_MIN_INTERVAL_GOOGLE=0

# Positionstack (https://positionstack.com) — key del panel "Access Key".
POSITIONSTACK_ENDPOINT=https://api.positionstack.com
POSITIONSTACK_ACCESS_KEY=

# Topes anti-abuso por IP (protegen la cuota del proveedor). 0 = desactivado.
GEO_MAX_PER_HOUR_IP_SEARCH=60
GEO_MAX_PER_HOUR_IP_REVERSE=120

# Envío de OTP por SMS
# SMS_PROVIDER=log        -> En desarrollo escribe el código en los logs (sin costo).
# SMS_PROVIDER=twilio     -> En producción envía SMS reales (requiere credenciales).
# SMS_PROVIDER=unimatrix  -> En producción envía SMS reales vía Unimatrix (requiere credenciales).
SMS_PROVIDER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Unimatrix (https://www.unimtx.com)
# Credenciales en el panel: Console -> Credentials (AccessKey ID y opcional AccessKey Secret).
# Si UNIMATRIX_ACCESS_KEY_SECRET se deja vacío se usa autenticación Simple (solo AccessKey ID).
# Si se llena, se usa autenticación HMAC (firma de los parámetros de la petición).
# UNIMATRIX_SENDER es el remitente (2-16 caracteres). Vacío = Unimatrix asigna uno neutro.
# UNIMATRIX_TEMPLATE_MODE:
#   default  -> usa UNIMATRIX_TEMPLATE_ID_DEFAULT y sustituye solo {code}.
#   business -> usa UNIMATRIX_TEMPLATE_ID_BUSINESS y sustituye {business_name} y {code}.
# Solo use 'business' cuando la plantilla con {business_name} esté Aprobada.
UNIMATRIX_ENDPOINT=https://api.unimtx.com
UNIMATRIX_ACCESS_KEY_ID=
UNIMATRIX_ACCESS_KEY_SECRET=
UNIMATRIX_SENDER=
UNIMATRIX_TIMEOUT=10

UNIMATRIX_TEMPLATE_MODE=default
UNIMATRIX_TEMPLATE_ID_DEFAULT=48b9587c
UNIMATRIX_TEMPLATE_ID_BUSINESS=

# Verificación por teléfono (OTP)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Límites anti-abuso de envío de SMS (rate limiting, se guardan en Redis).
# Poner 0 desactiva el límite correspondiente (no recomendado en producción).
OTP_MAX_PER_HOUR_PHONE=3      # Máximo códigos por teléfono, por hora
OTP_MAX_PER_DAY_PHONE=6       # Máximo códigos por teléfono, por día
OTP_MAX_PER_HOUR_IP=10        # Máximo solicitudes de código por IP, por hora
OTP_MAX_PER_MINUTE_BUSINESS=20 # Máximo global por negocio, por minuto
